{
  "dependencies": {
    "discord.js": "^14.28.1"
  },
  "description": "毎日お題を投稿して雑談を活性化する Discord Bot (まぶさば用)",
  "devDependencies": {
    "@types/node": "26.6.10",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/index.js",
  "name": "chat-topic-bot",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "deploy": "node --env-file=.env dist/src/deploy.js",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"package.json\" \"tsconfig.json\" \"ecosystem.config.cjs\" \".github/workflows/*.yml\" \".github/dependabot.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"package.json\" \"tsconfig.json\" \"ecosystem.config.cjs\" \".github/workflows/*.yml\" \".github/dependabot.yml\"",
    "start": "node --env-file=.env dist/src/index.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "version": "1.0.0"
}
